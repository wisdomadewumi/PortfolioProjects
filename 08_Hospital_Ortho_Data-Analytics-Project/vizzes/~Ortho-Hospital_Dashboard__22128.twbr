            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jn7hdg0ngaiu41aetv3n1om3pwv'>
            <column caption='% Change Wait Time Up' datatype='string' name='[% Change Wait Time Down (copy)_1557119571549261842]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1557119571548012560]&gt;0 then &quot;▲&quot; &#13;&#10;ELSE &quot;&quot; &#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='p.Month' datatype='boolean' name='[Calculation_1557119571455074317]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&#13;&#10;DATENAME(&apos;month&apos;,[date]))&#13;&#10;+&apos; &apos;+ &#13;&#10;STR(&#13;&#10;DATEPART(&apos;year&apos;,[date]))&#13;&#10;=&#13;&#10;[Parameters].[Parameter 1]' />
            </column>
            <column caption='% Change Wait Time' datatype='real' name='[Calculation_1557119571548012560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([patient_waittime])) - LOOKUP(ZN(AVG([patient_waittime])),-1))&#13;&#10;/ &#13;&#10;LOOKUP(ZN(AVG([patient_waittime])),-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Change Wait Time Down' datatype='string' name='[Calculation_1557119571549028369]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1557119571548012560]&lt;0 then &quot;▼&quot; &#13;&#10;ELSE &quot;&quot; &#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[patient_waittime]' derivation='Avg' name='[avg:patient_waittime:qk]' pivot='key' type='quantitative' />
            <column caption='Date' datatype='datetime' name='[date]' role='dimension' type='ordinal' />
            <column caption='Department Referral' datatype='string' name='[department_referral]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='MY' name='[my:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1557119571455074317]' derivation='None' name='[none:Calculation_1557119571455074317:nk]' pivot='key' type='nominal' />
            <column-instance column='[department_referral]' derivation='None' name='[none:department_referral:nk]' pivot='key' type='nominal' />
            <column-instance column='[patient_admin_flag]' derivation='None' name='[none:patient_admin_flag:nk]' pivot='key' type='nominal' />
            <column-instance column='[patient_gender]' derivation='None' name='[none:patient_gender:nk]' pivot='key' type='nominal' />
            <column-instance column='[patient_race]' derivation='None' name='[none:patient_race:nk]' pivot='key' type='nominal' />
            <column caption='Patient Admin Flag' datatype='boolean' name='[patient_admin_flag]' role='dimension' type='nominal' />
            <column caption='Patient Gender' datatype='string' name='[patient_gender]' role='dimension' type='nominal' />
            <column caption='Patient Race' datatype='string' name='[patient_race]' role='dimension' type='nominal' />
            <column caption='Wait Time' datatype='integer' name='[patient_waittime]' role='measure' type='quantitative' />
            <column-instance column='[% Change Wait Time Down (copy)_1557119571549261842]' derivation='User' name='[usr:% Change Wait Time Down (copy)_1557119571549261842:nk:1]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
