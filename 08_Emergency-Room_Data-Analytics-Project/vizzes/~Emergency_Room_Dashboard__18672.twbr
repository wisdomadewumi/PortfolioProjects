      <aliases enabled='yes' />
      <column caption='p.Month' datatype='boolean' name='[Calculation_1557119571455074317]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&#13;&#10;DATENAME(&apos;month&apos;,[date]))&#13;&#10;+&apos; &apos;+ &#13;&#10;STR(&#13;&#10;DATEPART(&apos;year&apos;,[date]))&#13;&#10;=&#13;&#10;[Parameters].[Parameter 1]' />
      </column>
      <column caption='Month Year' datatype='string' name='[Calculation_1557119571455688718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&#13;&#10;DATENAME(&apos;month&apos;,[date]))&#13;&#10;+&apos; &apos;+ &#13;&#10;STR(&#13;&#10;DATEPART(&apos;year&apos;,[date]))' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_1557119571456503823]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [date])' />
      </column>
      <column caption='Current Year' datatype='datetime' name='[Calculation_1557119571784040468]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;year&apos;, [date])) }' />
      </column>
      <column caption='Max Patient Tooltip' datatype='string' name='[Calculation_1557119571791839266]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1557119639804768258] = WINDOW_MAX([Calculation_1557119639804768258])&#13;&#10;THEN &apos;This was the busiest day in &apos; + [Parameters].[Parameter 1]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Age Groups' datatype='string' name='[Calculation_1557119571800023077]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [patient_age] &gt;= 0 AND [patient_age] &lt;= 18 THEN &apos;0-18&apos;&#13;&#10;ELSEIF [patient_age] &gt;= 19 AND [patient_age] &lt;= 34 THEN &apos;19-34&apos;&#13;&#10;ELSEIF [patient_age] &gt;= 35 AND [patient_age] &lt;= 50 THEN &apos;35-50&apos;&#13;&#10;ELSEIF [patient_age] &gt;= 51 AND [patient_age] &lt;= 65 THEN &apos;51-65&apos;&#13;&#10;ELSE &apos;Above 66&apos;&#13;&#10;END' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_1557119639801978881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Count Patient Visit' datatype='integer' name='[Calculation_1557119639804768258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([patient_id])' />
      </column>
      <column caption='Patient Gender_string' datatype='string' name='[Calculation_1557119639810580486]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [patient_gender]&#13;&#10;    WHEN &apos;M&apos; THEN &apos;Male&apos;&#13;&#10;    WHEN &apos;F&apos; THEN &apos;Female&apos;&#13;&#10;    ELSE &apos;Non-conforming&apos;&#13;&#10;END' />
      </column>
      <column caption='Max Patient' datatype='integer' name='[Count Patient Visit (copy)_1557119571791196192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1557119639804768258] = WINDOW_MAX([Calculation_1557119639804768258])&#13;&#10;THEN [Calculation_1557119639804768258]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Current Month' datatype='datetime' name='[Current Year (copy)_1557119571784478741]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [date])) }' />
      </column>
      <column caption='Min Patient' datatype='integer' name='[Max Patient (copy)_1557119571791446049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1557119639804768258] = WINDOW_MIN([Calculation_1557119639804768258])&#13;&#10;THEN [Calculation_1557119639804768258]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Min Patient Tooltip' datatype='string' name='[Max Patient Tooltip (copy)_1557119571792068643]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1557119639804768258] = WINDOW_MIN([Calculation_1557119639804768258])&#13;&#10;THEN &apos;This was the least busy day in &apos; + [Parameters].[Parameter 1]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Patient Admin Flag_string' datatype='string' name='[Patient Gender_string (copy)_1557119639824322569]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [patient_admin_flag]&#13;&#10;    WHEN TRUE THEN &apos;Admin Needed&apos;&#13;&#10;    ELSE &apos;No Admin&apos;&#13;&#10;END' />
      </column>
