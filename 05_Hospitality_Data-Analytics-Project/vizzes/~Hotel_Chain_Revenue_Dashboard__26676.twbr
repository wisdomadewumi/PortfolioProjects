    <worksheet name='Sheet 2'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_bookings+' name='federated.16xojij1l6thxs17qevjq1sre7zt' />
          </datasources>
          <datasource-dependencies datasource='federated.16xojij1l6thxs17qevjq1sre7zt'>
            <column caption='RevPAR' datatype='real' name='[ADR (copy)_1877156685664030736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;Revenue Per Available Room&#13;&#10;&#13;&#10;RevPAR represents the revenue generated per available room,&#13;&#10;whether or not they are occupied.&#13;&#10;RevPAR helps hotels measure their revenue generating&#13;&#10;performance to accurately price rooms.&#13;&#10;RevPAR can help hotels measure themselves against other&#13;&#10;properties or brands.&#13;&#10;&#13;&#10;*/&#13;&#10;[Calculation_1877156685523722241] / [Calculation_1877156685624393731]' />
            </column>
            <column caption='Revenue' datatype='integer' name='[Calculation_1877156685523722241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_realized])' />
            </column>
            <column caption='Total Bookings' datatype='integer' name='[Calculation_1877156685624279042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([booking_id])' />
            </column>
            <column caption='Total Capacity' datatype='integer' name='[Calculation_1877156685624393731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([capacity])' />
            </column>
            <column caption='Number of Days' datatype='integer' name='[Calculation_1877156685651501062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,MIN([date]),MAX([date])) + 1' />
            </column>
            <column caption='Total Cancelled Bookings' datatype='real' name='[Calculation_1877156685654061063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [booking_status] = &apos;Cancelled&apos; THEN 1 ELSE 0 END) / SUM(1)' />
            </column>
            <column caption='Cancellation Rate' datatype='real' default-format='p0.0%' name='[Calculation_1877156685656043528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1877156685654061063] / [Calculation_1877156685624279042]' />
            </column>
            <column caption='ADR' datatype='real' name='[Calculation_1877156685663199246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Average Daily Rate */&#13;&#10;[Calculation_1877156685523722241] / [Calculation_1877156685624279042]' />
            </column>
            <column caption='Realization Rate' datatype='real' default-format='p0.0%' name='[Calculation_1877156685663653903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Customers who successfully checked out */&#13;&#10;1 - ([Calculation_1877156685656043528] + [Cancellation Rate (copy)_1877156685657395211])' />
            </column>
            <column caption='DBRN' datatype='real' name='[Calculation_1877156685664505874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;DBRN(Daily Booked Room Nights)&#13;&#10;&#13;&#10;This metrics tells on average how many rooms are booked for&#13;&#10;a day considering a time period&#13;&#10;*/&#13;&#10;&#13;&#10;[Calculation_1877156685624279042] / [Calculation_1877156685651501062]' />
            </column>
            <column caption='No Show Rate' datatype='real' default-format='p0.0%' name='[Cancellation Rate (copy)_1877156685657395211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Checked Out Bookings (copy)_1877156685656805386] / [Calculation_1877156685624279042]' />
            </column>
            <column caption='DSRN' datatype='real' name='[DBRN (copy)_1877156685664718867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;DSRN(Daily Sellable Room Nights)&#13;&#10;&#13;&#10;This metrics tells on average how many rooms are ready to&#13;&#10;sell for a day considering a time period&#13;&#10;*/&#13;&#10;&#13;&#10;[Calculation_1877156685624393731] / [Calculation_1877156685651501062]' />
            </column>
            <column caption='DURN' datatype='real' name='[DSRN (copy)_1877156685664956437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;DSRN(Daily Sellable Room Nights)&#13;&#10;&#13;&#10;This metrics tells on average how many rooms are ready to&#13;&#10;sell for a day considering a time period&#13;&#10;*/&#13;&#10;&#13;&#10;[Total Cancelled Bookings (copy)_1877156685656559625] / [Calculation_1877156685651501062]' />
            </column>
            <column caption='Total Checked Out Bookings' datatype='real' name='[Total Cancelled Bookings (copy)_1877156685656559625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [booking_status] = &apos;Checked Out&apos; THEN 1 ELSE 0 END) / SUM(1)' />
            </column>
            <column caption='Total No Show Bookings' datatype='real' name='[Total Checked Out Bookings (copy)_1877156685656805386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [booking_status] = &apos;No Show&apos; THEN 1 ELSE 0 END) / SUM(1)' />
            </column>
            <column caption='Booking Id' datatype='string' name='[booking_id]' role='dimension' type='nominal' />
            <column caption='Booking Status' datatype='string' name='[booking_status]' role='dimension' type='nominal' />
            <column caption='Capacity' datatype='integer' name='[capacity]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Revenue Realized' datatype='integer' name='[revenue_realized]' role='measure' type='quantitative' />
            <column-instance column='[ADR (copy)_1877156685664030736]' derivation='User' name='[usr:ADR (copy)_1877156685664030736:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1877156685663199246]' derivation='User' name='[usr:Calculation_1877156685663199246:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1877156685663653903]' derivation='User' name='[usr:Calculation_1877156685663653903:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1877156685664505874]' derivation='User' name='[usr:Calculation_1877156685664505874:qk]' pivot='key' type='quantitative' />
            <column-instance column='[DBRN (copy)_1877156685664718867]' derivation='User' name='[usr:DBRN (copy)_1877156685664718867:qk]' pivot='key' type='quantitative' />
            <column-instance column='[DSRN (copy)_1877156685664956437]' derivation='User' name='[usr:DSRN (copy)_1877156685664956437:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
