      <column caption='Total Checked Out Bookings' datatype='real' name='[Total Cancelled Bookings (copy)_1877156685656559625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [booking_status] = &apos;Checked Out&apos; THEN 1 ELSE 0 END) / SUM(1)' />
